# ── Sama Agent — variables d'environnement (ce fichier est un MODÈLE) ─────────
# Copier vers .env (jamais commité) puis adapter. Secrets réels : registre Brev au jour J.

# Mode du worker : "deterministic" (Version B honnête, sans LLM/audio) | "live" (jour J GPU)
SAMA_MODE=deterministic

# Persistance (source de vérité, référence §7).
#   dev/tests : sqlite (défaut var/sama.db ; "sqlite://" = mémoire)
#   prod Brev  : postgresql+psycopg://user:pass@host:5432/sama
# SAMA_DATABASE_URL=sqlite:///./var/sama.db

# LLM / vision — GLM-5.3-Flash (NVIDIA NIM)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=<secret>
NVIDIA_MODEL=glm-5.3-flash

# ASR wolof — Kiriku-Wolof-ASR (AIHubSN, GPU Brev)
# KIRIKU_MODEL=AIHubSN/Kiriku-Wolof-ASR
# SAMA_DEVICE=cuda

# TTS wolof — xTTS-v2-wolof (GalsenAI, GPU Brev)
# XTTS_MODEL=galsenai/xTTS-v2-wolof
# XTTS_SPEAKER=<wav de référence 6 s>

# LiveKit (voice) — worker autorité de la room
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=<secret>
LIVEKIT_API_SECRET=<secret>
LIVEKIT_ROOM=sama-demo

# API
ALLOWED_ORIGINS=http://localhost:3000
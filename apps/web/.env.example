# Copier vers .env.local — secrets jamais commités
NEXT_PUBLIC_API_URL=http://localhost:8000        # FastAPI worker (D1)
NEXT_PUBLIC_APP_URL=http://localhost:3000
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=z-ai/glm-5.3

# Authentification Supabase (email/mot de passe + Google) — identité réelle.
# OBLIGATOIRE en production : sans ces deux clés, l'espace reste fermé et la
# connexion est signalée indisponible (l'app ne s'ouvre plus sans compte).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clé anon Supabase>

# Harnais de test UNIQUEMENT (E2E, dév local sans compte) : ouvre l'espace sans
# connexion. Ne JAMAIS définir sur Vercel / en production.
# NEXT_PUBLIC_SAMA_HARNESS=1

# Copier vers ~/sama.env SUR LA MACHINE BREV, puis remplir. Jamais commité.
SAMA_MODE=live
SAMA_DEVICE=cuda
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_EXTRACT_MODEL=z-ai/glm-5.3-flash
# Intention VOCALE sur le modèle rapide (sinon 35–49 s d'attente par phrase)
NVIDIA_VOICE_MODEL=z-ai/glm-5.3-flash
LLM_TIMEOUT_SECS=300
# Supabase : Project Settings → Database → Connection string (pooler, port 6543)
SAMA_DATABASE_URL=postgresql+psycopg://
# Supabase : Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=
# LiveKit Cloud : Settings → Keys
LIVEKIT_URL=wss://
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Adresse exacte du site Vercel (sans / final)
ALLOWED_ORIGINS=https://
# Voix de l'agent en WOLOF : Adia (CONCREE/Adia_TTS, Apache 2.0) = voix officielle ;
# mms (facebook/mms-tts-wol) ne sert que si Adia tombe en panne. Écoute/latence :
#   python scripts/tts-wolof-check.py
SAMA_TTS_WOLOF=adia,mms
# Réglages Adia (optionnels) : voix décrite en anglais, graine = même voix à chaque phrase
# ADIA_DESCRIPTION=A clear and educational voice, with a flow adapted to learning
# ADIA_SEED=42
# Repli si aucune voix wolof ne répond : voix française Edge
SAMA_TTS_BACKEND=edge
KIRIKU_MODEL=AIHubSN/Kiriku-Wolof-ASR
